NODE_ENV=production
PORT=5000
LOG_LEVEL=info

DATABASE_URL=postgres://pets:pets@postgres:5432/pets

JWT_SECRET=compose-dev-jwt-secret-change-me-0123456789
JWT_EXPIRES_IN=15m
BCRYPT_ROUNDS=12
TRUST_PROXY_HOPS=1

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=10

REDIS_URL=redis://redis:6379
CACHE_ENABLED=true
CACHE_TTL_PETS_LIST=30
CACHE_TTL_PET_BY_ID=60

RABBITMQ_URL=amqp://admin:secretpassword@rabbit_mq:5672
BROKER_ENABLED=true
