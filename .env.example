NODE_ENV=development
PORT=5000
LOG_LEVEL=debug

DATABASE_URL=postgres://pets:pets@localhost:5432/pets
JWT_SECRET=local-dev-jwt-secret-change-me-0123456789
JWT_EXPIRES_IN=15m
BCRYPT_ROUNDS=10
TRUST_PROXY_HOPS=0

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=10

REDIS_URL=redis://127.0.0.1:6379
CACHE_ENABLED=true
CACHE_TTL_PETS_LIST=30
CACHE_TTL_PET_BY_ID=60

RABBITMQ_URL=amqp://localhost:5672
BROKER_ENABLED=true
